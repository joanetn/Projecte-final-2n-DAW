# Copia aquest fitxer a .env.docker i omple els valors reals
# Docker Compose llegeix aquest fitxer automàticament si es diu ".env"
# (opcionalment: docker compose --env-file .env.docker up)

# Laravel
APP_KEY=base64:CANVIA_AIXO_php_artisan_key_generate
JWT_SECRET=CANVIA_AIXO_string_aleatori_llarg

# Base de dades
DB_USERNAME=projecte
DB_PASSWORD=canvia_aquesta_contrasenya
DB_DATABASE=projecte_final

# Stripe (opcional, només si uses pagaments)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
VITE_STRIPE_PUBLIC_KEY=pk_test_xxx

# Twilio (WhatsApp prova)
SMS_TWILIO_ENABLED=true
SMS_TWILIO_CHANNEL=whatsapp
SMS_TWILIO_BASE_URL=https://api.twilio.com
SMS_TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SMS_TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SMS_TWILIO_FROM_NUMBER=
SMS_TWILIO_MESSAGING_SERVICE_SID=
SMS_DEFAULT_COUNTRY_CODE=34

# Invitacions -> força enviament WhatsApp a un número de prova
INVITATION_FORCE_WHATSAPP_TEST=true
INVITATION_FORCE_WHATSAPP_PHONE=
INVITATION_FORCE_WHATSAPP_CONTENT_SID=HXb5b62575e6e4ff6129ad7c8efe1f983e
INVITATION_FORCE_WHATSAPP_CONTENT_VARIABLES={"1":"12/1","2":"3pm"}
